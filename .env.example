# Sao chép thành .env rồi chỉnh giá trị. Không commit file .env.

# --- Oracle Docker ---
# Image mặc định: Oracle AI Database 26ai Free (đa kiến trúc)
ORACLE_IMAGE=container-registry.oracle.com/database/free:latest
# Nếu image trên lỗi kiến trúc, thử: gvenzl/oracle-free:latest
# ORACLE_IMAGE=gvenzl/oracle-free:latest

# Mật khẩu SYS/SYSTEM trong container (demo local, đổi khi dùng thật)
ORACLE_PWD=ZooOracle_Demo1
ORACLE_PASSWORD=ZooOracle_Demo1

# PDB kết nối ứng dụng
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE=FREEPDB1
ORACLE_USER=ZOO
ORACLE_PASSWORD_ZOO=ZooApp_Demo1

# Chuỗi kết nối thin mode (python-oracledb)
# Ví dụ: localhost:1521/FREEPDB1
DATABASE_URL=localhost:1521/FREEPDB1

# --- API (FastAPI) ---
API_HOST=0.0.0.0
API_PORT=8000
JWT_SECRET=doi_chuoi_nay_bang_chuoi_ngau_nhien_dai
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
BCRYPT_ROUNDS=12

# --- Web (Vue / Vite) ---
VITE_API_URL=http://localhost:8000
